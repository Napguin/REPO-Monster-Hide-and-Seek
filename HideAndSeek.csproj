<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HideAndSeekMonster</AssemblyName>
    <RootNamespace>HideAndSeekMonster</RootNamespace>
    <Version>1.5.43</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- REQUIRED: the game DLLs are publicized (private members made public). Mono only skips its access
         checks for assemblies marked unverifiable, which this switch does. Without it the mod throws
         FieldAccessException / MethodAccessException at runtime (e.g. empty start menu). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- File metadata (shown in Windows file properties). A DLL without any of this looks more suspicious
         to heuristic virus scanners. -->
    <Product>Hide And Seek Monster</Product>
    <AssemblyTitle>Hide And Seek Monster – R.E.P.O. mod (BepInEx plugin)</AssemblyTitle>
    <Description>BepInEx plugin for R.E.P.O.: hide and seek game mode where one player becomes a monster. Source: https://github.com/Napguin/REPO-Monster-Hide-and-Seek</Description>
    <Company>Napguin</Company>
    <Authors>Napguin</Authors>
    <Copyright>Copyright © Napguin 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryUrl>https://github.com/Napguin/REPO-Monster-Hide-and-Seek</RepositoryUrl>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Optional: path to your R.E.P.O. install, e.g. C:\Program Files (x86)\Steam\steamapps\common\REPO
         If set, the built DLL is copied into BepInEx\plugins automatically. -->
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <!-- Default: get references from NuGet (needs the BepInEx feed from nuget.config). -->
  <ItemGroup Condition="'$(LocalLibs)' == ''">
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="0.4.4-ngd.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Alternative: dotnet build -p:LocalLibs=C:\path\to\folder\with\dlls -->
  <ItemGroup Condition="'$(LocalLibs)' != ''">
    <Reference Include="$(LocalLibs)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(GameDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\HideAndSeekMonster" />
  </Target>

</Project>
